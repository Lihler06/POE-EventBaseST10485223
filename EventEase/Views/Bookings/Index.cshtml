@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<h1>Bookings</h1>

<!-- SEARCH SECTION -->
<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Search Booking ID, Event Name, or Venue Name"
                   value="@Context.Request.Query["searchString"]" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>

        <div class="col-md-2">
            <a href="@Url.Action("Index", "Bookings")" class="btn btn-secondary">Reset</a>
        </div>
    </div>
</form>

<!-- CREATE BUTTON -->
<p>
    <a asp-action="Create" class="btn btn-success">Create New Booking</a>
</p>

<!-- TABLE -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Booking Date</th>
            <th>Venue</th>
            <th>Event</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.BookingDate.ToString("yyyy-MM-dd")
                </td>

                <td>
                    @item.Venue?.Name
                </td>

                <td>
                    @item.Event?.EventName
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.BookingId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.BookingId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.BookingId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>